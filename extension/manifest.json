{
  "manifest_version": 3,
  "name": "TokensTab Collector",
  "version": "0.1.0",
  "description": "Reads current Higgsfield prices for the TokensTab desktop app. Runs only when you press the button.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://higgsfield.ai/*", "http://127.0.0.1:47821/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://higgsfield.ai/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "TokensTab Collector", "default_icon": { "32": "icons/32.png", "128": "icons/128.png" } },
  "icons": { "32": "icons/32.png", "128": "icons/128.png" }
}
